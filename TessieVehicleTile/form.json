{
  "elements": [
    {
      "type": "Label",
      "caption": "Eigenständige Kachel für ein Tessie-Fahrzeug. Die Datenquelle wird automatisch erkannt, wenn es genau eine TessieVehicle-Instanz gibt – nur bei mehreren musst du unten manuell wählen. Die Kachel füllt die Tile randlos und ist von der Datenverbindung getrennt."
    },
    {
      "type": "SelectInstance",
      "name": "SourceInstance",
      "caption": "Datenquelle (leer = automatisch erkennen)",
      "validModules": ["{3F1F7E31-8BA0-4B8F-9B62-47DAD7A0B6C9}"]
    },
    {
      "type": "CheckBox",
      "name": "AdoptVehicleName",
      "caption": "Kachelname automatisch vom Fahrzeug übernehmen"
    },
    {
      "type": "ExpansionPanel",
      "caption": "🎨 Statusfarben",
      "items": [
        { "type": "SelectColor", "name": "ColorCharging", "caption": "Lädt" },
        { "type": "SelectColor", "name": "ColorReady", "caption": "Bereit" },
        { "type": "SelectColor", "name": "ColorIdle", "caption": "Inaktiv/Unbekannt" }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "🖌️ Flächen & Text",
      "items": [
        { "type": "SelectColor", "name": "ColorBackground", "caption": "Hintergrund" },
        { "type": "SelectColor", "name": "ColorBox", "caption": "Kacheln/Boxen" },
        { "type": "SelectColor", "name": "ColorText", "caption": "Text (Werte)" },
        { "type": "SelectColor", "name": "ColorTextMuted", "caption": "Text (Beschriftungen)" }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "🔤 Schrift",
      "items": [
        {
          "type": "Select",
          "name": "FontFamily",
          "caption": "Schriftart",
          "options": [
            { "caption": "System (Standard)", "value": "system" },
            { "caption": "Arial", "value": "arial" },
            { "caption": "Verdana", "value": "verdana" },
            { "caption": "Tahoma", "value": "tahoma" },
            { "caption": "Trebuchet MS", "value": "trebuchet" },
            { "caption": "Georgia (Serif)", "value": "georgia" },
            { "caption": "Courier New (Monospace)", "value": "courier" }
          ]
        },
        {
          "type": "NumberSpinner",
          "name": "FontScale",
          "caption": "Schriftgröße (Faktor)",
          "digits": 2,
          "minimum": 0.5,
          "maximum": 2.5,
          "suffix": "×"
        }
      ]
    },
    {
      "type": "CheckBox",
      "name": "ShowControls",
      "caption": "Bedien-Buttons anzeigen (Verriegeln, Klima, Laden)"
    }
  ],
  "actions": [
    {
      "type": "Button",
      "caption": "Farben & Schrift auf Standard zurücksetzen",
      "onClick": "TESSIETILE_ResetStyle($id);"
    }
  ],
  "status": [
    { "code": 102, "icon": "active", "caption": "Aktiv" },
    { "code": 104, "icon": "inactive", "caption": "Keine Datenquelle gewählt" }
  ]
}
