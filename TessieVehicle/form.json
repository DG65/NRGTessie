{
    "elements": [
        {
            "type": "NumberSpinner",
            "name": "UpdateInterval",
            "caption": "Update Intervall (Sekunden)",
            "suffix": " s",
            "minimum": 0,
            "maximum": 3600
        },
        {
            "type": "SelectCategory",
            "name": "InstanceLocation",
            "caption": "Ablageort Instanz (optional)",
            "onChange": "TESSIE_SetInstanceLocation($id, $InstanceLocation);"
        },
        {
            "type": "Label",
            "caption": "Telemetrie-Variablen werden automatisch angelegt, sobald das Fahrzeug die entsprechenden Daten sendet."
        },
        {
            "type": "List",
            "name": "VisibleVars",
            "caption": "Datenpunkte",
            "rowCount": 15,
            "add": false,
            "delete": false,
            "changeOrder": true,
            "loadValuesFromConfiguration": false,
            "columns": [
                {
                    "caption": "Aktiv",
                    "name": "Enabled",
                    "width": "80px",
                    "add": true,
                    "edit": { "type": "CheckBox" }
                },
                {
                    "caption": "Name",
                    "name": "Name",
                    "width": "auto",
                    "add": ""
                },
                {
                    "caption": "Gruppe",
                    "name": "Gruppe",
                    "width": "170px",
                    "add": ""
                },
                {
                    "caption": "Ident",
                    "name": "Ident",
                    "width": "300px",
                    "add": "",
                    "save": true
                },
                {
                    "caption": "Empfangen",
                    "name": "Empfangen",
                    "width": "110px",
                    "add": ""
                }
            ],
            "values": []
        },
        {
            "type": "Label",
            "caption": "Deaktivierte Datenpunkte werden ausgeblendet - Objekt-ID und Archivdaten bleiben erhalten. Neue Telemetrie wird nur angelegt, solange aktiviert. Zeilen per Drag & Drop sortieren - Variablen und Links folgen der Reihenfolge."
        },
        {
            "type": "ExpansionPanel",
            "caption": "Linkstruktur",
            "items": [
                {
                    "type": "Label",
                    "caption": "Erzeugt am gewählten Zielort einen gruppierten Kategoriebaum (Laden, Klima, Sicherheit, Sonstiges) mit Links auf alle aktiven Datenpunkte. Links deaktivierter Datenpunkte werden automatisch entfernt."
                },
                {
                    "type": "CheckBox",
                    "name": "CreateLinks",
                    "caption": "Linkstruktur erzeugen"
                },
                {
                    "type": "SelectCategory",
                    "name": "LinksLocation",
                    "caption": "Zielkategorie"
                },
                {
                    "type": "CheckBox",
                    "name": "CleanupLinks",
                    "caption": "Links automatisch bereinigen"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Standort-Erkennung (Geofence)",
            "items": [
                {
                    "type": "Label",
                    "caption": "Legt je Standort eine Status-Variable an ('Zu Hause' bzw. Standortname), die true wird, sobald die Fahrzeugposition innerhalb des Radius liegt, sowie eine Textvariable 'Aktueller Standort' (Standortname bzw. 'Unterwegs'). Benötigt aktive GPS-Telemetrie (Datenpunkt 'Fahrzeugposition'). Bei Deaktivierung oder Entfernen bleiben die Variablen erhalten (nur ausgeblendet)."
                },
                {
                    "type": "CheckBox",
                    "name": "HomeDetection",
                    "caption": "Standort-Erkennung aktivieren"
                },
                {
                    "type": "SelectLocation",
                    "name": "HomeLocation",
                    "caption": "Standort Zuhause (leer = Systemstandort aus Kern-Instanz 'Location')"
                },
                {
                    "type": "NumberSpinner",
                    "name": "HomeRadius",
                    "caption": "Radius Zuhause",
                    "suffix": " m",
                    "minimum": 10,
                    "maximum": 5000
                },
                {
                    "type": "List",
                    "name": "GeofenceList",
                    "caption": "Weitere Standorte",
                    "rowCount": 5,
                    "add": true,
                    "delete": true,
                    "columns": [
                        {
                            "caption": "Name",
                            "name": "Name",
                            "width": "200px",
                            "add": "",
                            "edit": { "type": "ValidationTextBox" }
                        },
                        {
                            "caption": "Standort",
                            "name": "Location",
                            "width": "auto",
                            "add": "",
                            "edit": { "type": "SelectLocation" }
                        },
                        {
                            "caption": "Radius (m)",
                            "name": "Radius",
                            "width": "120px",
                            "add": 100,
                            "edit": { "type": "NumberSpinner", "suffix": " m", "minimum": 10, "maximum": 5000 }
                        }
                    ]
                },
                {
                    "type": "Label",
                    "caption": "Der Name des Standorts wird als Variablenname und in 'Aktueller Standort' verwendet. Bei überlappenden Zonen gewinnt der nächstgelegene Standort."
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Reset: Standardliste wiederherstellen",
            "confirm": "Wirklich die Variablenliste und Reihenfolge auf Standard zurücksetzen?",
            "onClick": "TESSIE_ResetVisibleVars($id);"
        },
        {
            "type": "Button",
            "name": "ToggleTelemetry",
            "caption": "Telemetrie: alle einblenden",
            "onClick": "TESSIE_ToggleAllTelemetry($id);"
        },
        {
            "type": "Button",
            "caption": "Telemetrie: nur wichtige einblenden",
            "confirm": "Nicht wichtige Telemetrie-Datenpunkte werden ausgeblendet. Fortfahren?",
            "onClick": "TESSIE_SetImportantTelemetryEnabled($id);"
        },
        {
            "type": "Button",
            "caption": "Telemetrie: Namen aktualisieren",
            "confirm": "Telemetrie-Variablennamen im Objektbaum anhand locale.json aktualisieren?",
            "onClick": "TESSIE_RenameTelemetryVariables($id);"
        },
        {
            "type": "Label",
            "caption": "Name/Ident sind schreibgeschützt - du änderst nur 'Aktiv'. Reihenfolge per Drag & Drop (danach Übernehmen)."
        }
    ],
    "status": []
}
